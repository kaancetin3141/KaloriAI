# ── KaloriAI ortam değişkenleri örneği ──
# Bu dosyayı .env olarak kopyalayın: cp .env.example .env

# Veritabanı (PostgreSQL 17 — Prisma)
DATABASE_URL=postgresql://kaloriai_user:PASSWORD@127.0.0.1:5432/kaloriai

# İsteğe bağlı: USDA FoodData Central API anahtarı (gıda arama ek kaynağı)
# USDA_API_KEY=

# İsteğe bağlı: harici cron/pinger ile /api/push/cron tetiklemek için sır.
# Ayarlanmazsa uç fail-closed çalışır (401); dahili zamanlayıcı yine de her dakika tarar.
# CRON_SECRET=

# Hatırlatıcı saatlerinin hesaplandığı saat dilimi (varsayılan: Europe/Istanbul)
# APP_TZ=Europe/Istanbul
